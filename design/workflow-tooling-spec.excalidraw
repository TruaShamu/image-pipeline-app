  {
   "type": "text",
   "id": "r_1_t",
   "containerId": "r_1",
   "x": 46,
   "y": 122,
   "width": 1608,
   "height": 16,
   "text": "4 primitives:  TOOL = code(inputs,ctx)->outputs ·  REGISTRY = map of tools ·  GRAPH = typed DAG (in-memory) saved as YAML ·  RUNNER executes it.   Key split: REPRESENTATION (canvas/YAML, for viewing) is separate from STEPS (the actual actions that run).",
   "fontSize": 15,
   "fontFamily": 1,
   "strokeColor": "#000000",
   "textAlign": "center",
   "verticalAlign": "middle"
  },
  {
   "type": "rectangle",
   "id": "tool_c",
   "x": 40,
   "y": 200,
   "width": 470,
   "height": 300,
   "strokeColor": "#107C10",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1.5,
   "roundness": {
    "type": 3
   }
  },
  {
   "type": "text",
   "id": "t_2",
   "x": 60,
   "y": 212,
   "width": 430,
   "height": 30.400000000000002,
   "text": "TOOL  =  just code (a STEP)",
   "fontSize": 19,
   "fontFamily": 1,
   "strokeColor": "#000000",
   "textAlign": "left",
   "verticalAlign": "top"
  },
  {
   "type": "text",
   "id": "t_3",
   "x": 60,
   "y": 248,
   "width": 450,
   "height": 179.20000000000002,
   "text": "{\n  id: \"image.generate\"\n  inputs: [{ name, type, required,\n            default?, options?, port? }]\n  outputs: [{ name, type }]   // [] for sinks\n  run(inputs, ctx) -> outputs\n}\n// ctx = { signal, log }",
   "fontSize": 14,
   "fontFamily": 3,
   "strokeColor": "#000000",
   "textAlign": "left",
   "verticalAlign": "top"
  },
  {
   "type": "rectangle",
